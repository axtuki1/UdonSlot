<Project Sdk="Microsoft.NET.Sdk">
  <!-- 生成エンジン（Editor/ReelRule/Core）を Unity なしで検証する。実行: dotnet run -c Release -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Core は Windows PowerShell 5 の Add-Type でも読めるよう C# 5 の範囲で書く -->
    <LangVersion>5</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Editor/ReelRule/Core/*.cs" />
    <Compile Include="../../Runtime/REV1_0/Slot/ReelControlData.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>
</Project>
